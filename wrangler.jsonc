{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liza-kovalova",
  // Аккаунт Cloudflare клиента (Elastica2024), там же домен lizakovalova.com
  "account_id": "e643e38a61e822f5a6e213879af9c3d7",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tg/*", "/p/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liza-kovalova",
      "database_id": "ea1c42d4-1ba3-4b79-8bc4-098b9afaeb5e",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "lizakovalova.com", "custom_domain": true },
    { "pattern": "www.lizakovalova.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Каждый час закрываем доступ с истёкшим сроком
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "APP_URL": "https://lizakovalova.com",
    // id закрытого канала (-100...) для каждой программы; одна программа = один канал,
    // несколько программ могут указывать на один канал
    // Telegram ID Лизы и администратора через запятую: им бот пишет о новых оплатах, вступлениях и возвратах
    "ADMIN_CHAT_IDS": "",
    "CHANNELS": "{\"back\":\"-1003625443111\",\"splits\":\"-1003725999391\",\"pilates\":\"-1003665201164\"}"
  }
  // Секреты (wrangler secret put ...): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // BOT_TOKEN, TG_WEBHOOK_SECRET, ADMIN_KEY
}
